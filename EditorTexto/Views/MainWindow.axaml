<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EditorTexto.ViewModels"
        xmlns:models="using:EditorTexto.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900"
        x:Class="EditorTexto.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Analizador de Gramáticas"
        Width="1200" Height="900"
        Background="White">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding EjecutarAnalisisCommand}"/>
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style Selector="Border.tableHeader">
            <Setter Property="Background" Value="#808080"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
        </Style>
        <Style Selector="Border.tableHeader TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.tableRow">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style Selector="Border.tableRow TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.f5btn">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.editor">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="MinHeight" Value="150"/>
            <Setter Property="FontFamily" Value="Consolas, Monospace"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style Selector="Border.outputBox">
            <Setter Property="Background" Value="#E6E6E6"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="MinHeight" Value="150"/>
        </Style>
    </Window.Styles>

    <ScrollViewer>
        <StackPanel Margin="30">
            <!-- Header -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Classes="title" Text="PROYECTO – INDIVIDUAL - 1"/>
                <Button Classes="f5btn" Content="F5" Command="{Binding EjecutarAnalisisCommand}"/>
            </StackPanel>
            
            <TextBlock Text="El proyecto consiste en desarrollar un sistema para capturar las reglas gramaticales en un editor de texto y la gramática será recursiva por la izquierda."
                       TextWrapping="Wrap" Margin="0,0,0,20" MaxWidth="600" HorizontalAlignment="Left"/>

            <!-- Main Layout (Left / Right) -->
            <Grid ColumnDefinitions="*,40,*">
                <!-- Left Pane: Input -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="▶" Foreground="Black" FontSize="20" Margin="0,0,10,0"/>
                        <TextBlock Classes="sectionTitle" Text="ENTRADA (editor de texto)"/>
                    </StackPanel>
                    
                    <TextBox Classes="editor" Text="{Binding InputText, Mode=TwoWay}" />

                    <!-- Tablas Entrada -->
                    <Grid ColumnDefinitions="150,20,*" Margin="0,20,0,0">
                        <StackPanel Grid.Column="0">
                            <Border BorderBrush="#333399" BorderThickness="0,0,0,1" Margin="0,0,0,5" Padding="0,0,0,5"><TextBlock Text="Vectores"/></Border>
                            <Grid ColumnDefinitions="*,*">
                                <Border Grid.Column="0" Classes="tableHeader"><TextBlock Text="V"/></Border>
                                <Border Grid.Column="1" Classes="tableHeader"><TextBlock Text="T"/></Border>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding InputVectors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:VectorRecord">
                                        <Grid ColumnDefinitions="*,*">
                                            <Border Grid.Column="0" Classes="tableRow"><TextBlock Text="{Binding V}"/></Border>
                                            <Border Grid.Column="1" Classes="tableRow"><TextBlock Text="{Binding T}"/></Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border BorderBrush="#333399" BorderThickness="0,0,0,1" Margin="0,0,0,5" Padding="0,0,0,5"><TextBlock Text="Matriz de Producciones"/></Border>
                            <Grid ColumnDefinitions="50,*">
                                <Border Grid.Column="0" Classes="tableHeader"><TextBlock Text="V"/></Border>
                                <Border Grid.Column="1" Classes="tableHeader"><TextBlock Text="Producciones"/></Border>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding InputProductions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProductionRecord">
                                        <Grid ColumnDefinitions="50,*">
                                            <Border Grid.Column="0" Classes="tableRow"><TextBlock Text="{Binding V}" FontWeight="Bold"/></Border>
                                            <Border Grid.Column="1" Classes="tableRow"><TextBlock Text="{Binding Producciones}" HorizontalAlignment="Left" Margin="10,0,0,0"/></Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Divider -->
                <Border Grid.Column="1" BorderBrush="#AAAAAA" BorderThickness="1,0,0,0" Width="1" Margin="20,0,20,0"/>

                <!-- Right Pane: Output -->
                <StackPanel Grid.Column="2">
                    <TextBlock Classes="sectionTitle" Text="Gramática Sin Recursividad por la izquierda (SALIDA)" Margin="0,5,0,5"/>
                    
                    <Border Classes="outputBox">
                        <TextBlock Text="{Binding OutputText}" FontFamily="Consolas, Monospace" FontSize="16" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Tablas Salida -->
                    <Grid ColumnDefinitions="150,20,*" Margin="0,20,0,0">
                        <StackPanel Grid.Column="0">
                            <Border BorderBrush="#333399" BorderThickness="0,0,0,1" Margin="0,0,0,5" Padding="0,0,0,5"><TextBlock Text="Vectores"/></Border>
                            <Grid ColumnDefinitions="*,*">
                                <Border Grid.Column="0" Classes="tableHeader"><TextBlock Text="V"/></Border>
                                <Border Grid.Column="1" Classes="tableHeader"><TextBlock Text="T"/></Border>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding OutputVectors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:VectorRecord">
                                        <Grid ColumnDefinitions="*,*">
                                            <Border Grid.Column="0" Classes="tableRow"><TextBlock Text="{Binding V}"/></Border>
                                            <Border Grid.Column="1" Classes="tableRow"><TextBlock Text="{Binding T}"/></Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border BorderBrush="#333399" BorderThickness="0,0,0,1" Margin="0,0,0,5" Padding="0,0,0,5"><TextBlock Text="Matriz de Producciones"/></Border>
                            <Grid ColumnDefinitions="50,*">
                                <Border Grid.Column="0" Classes="tableHeader"><TextBlock Text="V"/></Border>
                                <Border Grid.Column="1" Classes="tableHeader"><TextBlock Text="Producciones"/></Border>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding OutputProductions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProductionRecord">
                                        <Grid ColumnDefinitions="50,*">
                                            <Border Grid.Column="0" Classes="tableRow"><TextBlock Text="{Binding V}" FontWeight="Bold"/></Border>
                                            <Border Grid.Column="1" Classes="tableRow"><TextBlock Text="{Binding Producciones}" HorizontalAlignment="Left" Margin="10,0,0,0"/></Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Bottom Pane: First & Follow -->
            <Grid ColumnDefinitions="*,40,*" Margin="0,40,0,0" IsVisible="{Binding ShowResults}">
                <!-- First Set -->
                <StackPanel Grid.Column="0">
                    <Border BorderBrush="#333399" BorderThickness="0,0,0,1" Margin="0,0,0,5" Padding="0,0,0,5"><TextBlock Classes="sectionTitle" Text="Función Primera" Margin="0"/></Border>
                    <Grid ColumnDefinitions="100,*">
                        <Border Grid.Column="0" Classes="tableHeader"><TextBlock Text="v"/></Border>
                        <Border Grid.Column="1" Classes="tableHeader"><TextBlock Text="Terminales"/></Border>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding FirstSets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:FirstFollowRecord">
                                <Grid ColumnDefinitions="100,*">
                                    <Border Grid.Column="0" Classes="tableRow"><TextBlock Text="{Binding V}"/></Border>
                                    <Border Grid.Column="1" Classes="tableRow"><TextBlock Text="{Binding Terminales}" HorizontalAlignment="Left" Margin="10,0,0,0"/></Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Follow Set -->
                <StackPanel Grid.Column="2">
                    <Border BorderBrush="#333399" BorderThickness="0,0,0,1" Margin="0,0,0,5" Padding="0,0,0,5"><TextBlock Classes="sectionTitle" Text="Función Siguiente" Margin="0"/></Border>
                    <Grid ColumnDefinitions="100,*">
                        <Border Grid.Column="0" Classes="tableHeader"><TextBlock Text="v"/></Border>
                        <Border Grid.Column="1" Classes="tableHeader"><TextBlock Text="Terminales"/></Border>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding FollowSets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:FirstFollowRecord">
                                <Grid ColumnDefinitions="100,*">
                                    <Border Grid.Column="0" Classes="tableRow"><TextBlock Text="{Binding V}"/></Border>
                                    <Border Grid.Column="1" Classes="tableRow"><TextBlock Text="{Binding Terminales}" HorizontalAlignment="Left" Margin="10,0,0,0"/></Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
            
        </StackPanel>
    </ScrollViewer>
</Window>
